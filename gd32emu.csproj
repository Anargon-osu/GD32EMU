<Project Sdk="Microsoft.NET.Sdk">
  <!-- gd32emu: one self-contained executable per platform (dotnet publish -r win-x64 / linux-x64 / osx-arm64 / osx-x64) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AssemblyName>gd32emu</AssemblyName>
    <LangVersion>5</LangVersion><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><Optimize>true</Optimize>
    <StartupObject>Gd32Emu.EmuProgram</StartupObject><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><InvariantGlobalization>true</InvariantGlobalization><DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup><Compile Include="gd32emu.cs;gd32emu_cli.cs" /></ItemGroup>
</Project>
